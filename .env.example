# Phish standalone — copy to .env and edit before `docker compose up -d`.

# ── Required ────────────────────────────────────────────────────
# JWT signing secret. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# Legacy token-based login for standalone mode (one-shot bootstrap).
# Once a user is created via the token login they can promote others
# through the directory.
AUTH_TOKEN=

# ── Data-at-rest encryption (recommended) ──────────────────────
# Encrypts the SMTP relay password and the M365 client
# secret before they are written to the database
# (AES-256-GCM).
# OPTIONAL for a standalone module: leave it unset and those secrets
# are stored in CLEARTEXT (the app logs a one-time warning to make
# that an explicit choice, not a silent one). Set it and existing
# rows migrate to ciphertext on their next write.
# Use a DEDICATED value, distinct from JWT_SECRET — reusing the
# session secret couples the session-forgery and data-at-rest trust
# domains. >= 32 chars. Rotating it makes secrets written under the
# old key unreadable; re-enter them after a rotation.
#   openssl rand -hex 32
# ENCRYPTION_KEY=change-me-to-a-dedicated-random-string

# Public base URL of this app (used for OAuth redirect URIs and the
# public tracking links sent in phishing emails).
APP_URL=http://localhost:8091

# ── Strongly recommended: restrict who can sign in ──────────────
# Comma-separated list of email domains allowed to authenticate. An IdP
# will happily validate an address you never meant to let in — an
# "external" Google OAuth client accepts ANY Gmail account. Leave empty
# and every address the IdP authenticates reaches the approval queue
# instead of being refused outright.
#   ALLOWED_EMAIL_DOMAINS=example.com,example.org
ALLOWED_EMAIL_DOMAINS=

# Regardless of the list above, only the FIRST account created becomes an
# admin. Every later account is parked as `pending` and cannot do anything
# until an admin promotes it (PUT /api/users/{id}, role: viewer|editor|admin).
# This matters here more than elsewhere: an active account can send email
# from your infrastructure and read who clicked.

# ── Optional: OAuth providers ───────────────────────────────────
# Leave blank to disable. ENTRA = Microsoft 365 / Azure AD.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=common

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_LABEL=

# ── Optional: outbound HTTP proxy (corporate egress) ───────────
# For hosts with NO direct internet access that must reach outbound
# services (the LLM API; for Surface also the CVE feeds and scan probes)
# through a corporate forward proxy. When set, httpx routes EVERY
# outbound call this backend makes through the proxy — it reads these
# from the environment at request time, so no code change is needed.
# The PostgreSQL connection uses asyncpg (not httpx) and is NEVER proxied.
# NO_PROXY lists hosts to reach directly (bypassing the proxy).
# Leave all three empty for direct outbound access (the default).
#   HTTP_PROXY=http://proxy.corp.example:8080
#   HTTPS_PROXY=http://proxy.corp.example:8080
#   NO_PROXY=localhost,127.0.0.1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
